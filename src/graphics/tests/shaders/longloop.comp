#version 450
layout(local_size_x = 1) in;
layout(set = 5, binding = 1) buffer Out { uint n; } o;
layout(set = 5, binding = 2) uniform C3 { uvec4 p; } c3;
void main() {
    // a loop long enough to show the bound (1,000,000 iterations when unbounded), short enough not to hang
    uint k = 0u;
    for (uint i = 0u; i < c3.p.x; i++) { k += 1u; }
    o.n = k;
}
