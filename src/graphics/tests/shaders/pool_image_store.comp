#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 6, binding = 2, rgba8) uniform writeonly image2D images[];
layout(push_constant) uniform Pools { uint texture_base; uint sampler_base; } pools;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    imageStore(images[pools.texture_base + 5], p, vec4(float(p.x) / 255.0, float(p.y) / 255.0, 0.5, 1.0));
}
