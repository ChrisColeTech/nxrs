#version 460
#extension GL_EXT_control_flow_attributes : require
// Buffer representation for bounded parity tests and the native model executor:
// tensors are packed fp16 NHWC with a zero border, pictures packed RGBA8/RGB10A2.
// No fp16 arithmetic/storage feature or vendor subgroup layout is required.
layout(local_size_x = 64) in;
layout(set=0, binding=0, std430) readonly buffer Input { uint a[]; };
layout(set=0, binding=1, std430) buffer Output { uint o[]; };
layout(set=0, binding=2, std430) readonly buffer Weights { uint w[]; };
layout(set=0, binding=3, std430) readonly buffer Bias { uint b[]; };
layout(set=0, binding=4, std430) readonly buffer Skip { uint s[]; };
layout(push_constant) uniform Args {
    uint width, height, ki, no;
    uint kind, count, rounding, reserved;
} p;

float ah(uint i) { return unpackHalf2x16(a[i >> 1])[i & 1]; }
float wh(uint i) { return unpackHalf2x16(w[i >> 1])[i & 1]; }
float bh(uint i) { return unpackHalf2x16(b[i >> 1])[i & 1]; }
float sh(uint i) { return unpackHalf2x16(s[i >> 1])[i & 1]; }
float rh(float x) { return unpackHalf2x16(packHalf2x16(vec2(x, 0.0))).x; }
uint addr(uint x, uint y, uint width, uint channels, uint c) {
    return ((y + 1) * (width + 2) + x + 1) * channels + c;
}
vec4 rgb10(uint v) {
    return vec4(v & 1023, (v >> 10) & 1023, (v >> 20) & 1023, v >> 30)
        / vec4(1023.0, 1023.0, 1023.0, 3.0);
}
uint pack10(vec4 v) {
    uvec4 q = uvec4(roundEven(clamp(v, 0.0, 1.0) * vec4(1023, 1023, 1023, 3)));
    return q.x | (q.y << 10) | (q.z << 20) | (q.w << 30);
}
// Each chain traverses taps, then 16-channel blocks. The skip is C of the
// FIRST multiply, not an addition after the convolution. The host supplies
// rounding=16: retained dmsh_hmma16816_f16 unpacks C, visits each packed pair's
// low then high half in k order with FP32 Fma, and packs once after k=15.
// Metal's two eight-product matrix operations are a distinct comparison target.
float convolution(uint x, uint y, uint n) {
    bool down = p.kind == 2, up = p.kind == 3;
    uint iw = down ? 2 * p.width : p.width;
    uint ow = up ? 2 * p.width : p.width;
    precise float acc = up ? sh(addr(x, y, ow, p.no, n)) : 0.0;
    uint taps = up ? 1 : down ? 4 : 9;
    [[dont_unroll]] for (uint t = 0; t < taps; ++t) {
        uint wt = up ? 2 * (y & 1) + (x & 1) : t;
        uint iy = up ? y / 2 + 1 : down ? 2 * y + t / 2 + 1 : y + t / 3;
        uint ix = up ? x / 2 + 1 : down ? 2 * x + t % 2 + 1 : x + t % 3;
        [[dont_unroll]] for (uint k = 0; k < p.ki; ++k) {
            acc = fma(ah((iy * (iw + 2) + ix) * p.ki + k),
                      wh((wt * p.ki + k) * p.no + n), acc);
            if ((k + 1) % p.rounding == 0) acc = rh(acc);
        }
    }
    return acc;
}
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= p.count) return;
    if (p.kind == 0) { // pack, two channels per invocation
        uint c = (id * 2) % 16, pixel = id / 8;
        uint x = pixel % p.width, y = pixel / p.width, sub = c / 4;
        vec4 v = unpackUnorm4x8(a[(2*y + sub/2) * (2*p.width) + 2*x + sub%2]);
        o[addr(x,y,p.width,16,c)/2] = packHalf2x16(vec2(v[c%4],v[c%4+1]));
    } else if (p.kind <= 3) {
        uint ow = p.kind == 3 ? 2*p.width : p.width;
        uint n = (2*id) % p.no, pixel = (2*id) / p.no;
        uint x = pixel % ow, y = pixel / ow;
        precise vec2 v = vec2(convolution(x,y,n),convolution(x,y,n+1)) + vec2(bh(n),bh(n+1));
        o[addr(x,y,ow,p.no,n)/2] = packHalf2x16(max(v,vec2(0.0)));
    } else if (p.kind == 4) { // out: picture + D, THEN bias, no ReLU/half epilogue
        uint x = id % (2*p.width), y = id / (2*p.width), sub = 2*(y&1)+(x&1);
        uvec4 ns = uvec4(2*sub,2*sub+1,8+2*sub,9+2*sub);
        vec4 pic = unpackUnorm4x8(s[id]);
        precise vec4 v;
        for (uint c=0; c<4; ++c) {
            precise float d = convolution(x/2,y/2,ns[c]);
            v[c] = (pic[c] + d) + bh(ns[c]);
        }
        o[id] = pack10(v);
    } else if (p.kind == 5) { // luma, explicit nested FMAs as in the model
        vec2 v;
        for (uint c=0; c<2; ++c) {
            vec3 rgb = rgb10(a[2*id+c]).xyz;
            precise float t = rgb.y * 0.715200006961822509765625;
            v[c] = fma(rgb.z,0.072200000286102294921875,
                       fma(rgb.x,0.2125999927520751953125,t));
        }
        o[id] = packHalf2x16(v);
    } else if (p.kind == 7) { // exact packed-word comparison, no epsilon
        if (a[id] != s[id]) { atomicAdd(o[0],1); atomicMin(o[1],id); }
    } else if (p.kind == 8) { // image comparison: differing texels and largest component step
        uint av=a[id], bv=s[id];
        if (av != bv) {
            atomicAdd(o[0],1);
            uvec4 ac,bc;
            if (p.reserved != 0) {
                ac=uvec4(av&255,(av>>8)&255,(av>>16)&255,av>>24);
                bc=uvec4(bv&255,(bv>>8)&255,(bv>>16)&255,bv>>24);
            } else {
                ac=uvec4(av&1023,(av>>10)&1023,(av>>20)&1023,(av>>30)*341);
                bc=uvec4(bv&1023,(bv>>10)&1023,(bv>>20)&1023,(bv>>30)*341);
            }
            atomicMax(o[1],uint(max(max(abs(int(ac.x)-int(bc.x)),abs(int(ac.y)-int(bc.y))),
                                    max(abs(int(ac.z)-int(bc.z)),abs(int(ac.w)-int(bc.w))))));
        }
    }
}
