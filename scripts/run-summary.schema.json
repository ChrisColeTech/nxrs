{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxrs.dev/schemas/run-summary-v1.json",
  "title": "NXRS run diagnostic summary",
  "type": "object",
  "required": ["schema", "run", "performance", "memory", "shaders", "gpu", "gaps", "threads", "audio", "red_diagnostics", "screenshots", "verdict", "artifacts"],
  "properties": {
    "schema": { "const": "nxrs.run-summary.v1" },
    "generated_unix": { "type": "number" },
    "triage": { "const": "triage.json", "description": "Optional backward-compatible link to compile/wait/fault, shader provenance and frame-cost evidence; not a gameplay verdict." },
    "run": {
      "type": "object",
      "required": ["result", "window_seconds", "scenario"],
      "properties": {
        "result": { "type": ["object", "null"], "description": "Harness exit, termination reason and elapsed runtime; required evidence for lifecycle acceptance." },
        "window_seconds": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "items": false }
          ]
        },
        "scenario": { "type": ["object", "null"] }
      }
    },
    "performance": {
      "type": "object",
      "required": ["frames", "fps", "frame_time_ms", "late_frames", "dropped_frames", "stutters", "dropped_work"],
      "properties": {
        "frames": { "type": "integer", "minimum": 0 },
        "fps": { "type": ["number", "null"] },
        "frame_time_ms": {
          "type": "object",
          "required": ["p50", "p95", "p99", "max"]
        },
        "expected_fps": { "type": "number", "exclusiveMinimum": 0, "description": "Scenario acceptance expected_fps/target_fps, then scenario-level target, otherwise legacy 60 FPS default." },
        "expected_frame_interval_ms": { "type": "number", "exclusiveMinimum": 0, "description": "1000 / expected_fps; used for target-relative lateness and estimated missing intervals." },
        "late_frames": { "type": ["integer", "null"], "minimum": 0, "description": "Observed intervals exceeding the expected frame interval; null when only fixed pacing buckets or no frames are available." },
        "late_frames_method": { "type": "string" },
        "dropped_frames": { "type": ["integer", "null"], "minimum": 0, "description": "Estimated missing target-rate presentation intervals, not measured actual drops or missing 60 Hz slots. Null for pacing-log bucket fallback and absent frame data." },
        "dropped_frames_method": { "type": "string" },
        "stutters": { "type": ["integer", "null"], "minimum": 0 },
        "dropped_work": { "type": "integer", "minimum": 0 },
        "metrics_fps": {
          "type": "object",
          "required": ["samples", "mean", "min"],
          "properties": {
            "samples": { "type": "integer", "minimum": 0 },
            "mean": { "type": ["number", "null"] },
            "min": { "type": ["number", "null"] }
          }
        },
        "pacing": {
          "type": "object",
          "required": ["samples", "fps_mean", "p95_ms", "p99_ms", "max_ms", "max_gap_seconds"],
          "properties": {
            "over_16_67_ms": { "type": ["integer", "null"], "minimum": 0, "description": "Raw fixed 16.67 ms bucket count, not target-relative late or dropped frames." },
            "over_33_50_100_ms": {
              "description": "Raw fixed pacing bucket counts, not actual drop totals; null for logs without buckets.",
              "type": ["array", "null"], "minItems": 3, "maxItems": 3,
              "items": { "type": "integer", "minimum": 0 }
            },
            "stutters_estimate": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "required": ["samples", "peak_mb", "slope_mb_per_min", "leak_warning"]
    },
    "shaders": {
      "type": "object",
      "properties": {
        "refused_unique": { "type": "integer", "minimum": 0, "description": "Unique keys with explicit failures or RED shader module-loader events; informational rewrites are excluded." },
        "refused_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "missing_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "prewarm": {
          "type": "array", "description": "Separate prewarm reports; skipped keys are not counted as module refusals.",
          "items": {
            "type": "object", "required": ["built", "keys", "without_shaders"],
            "properties": {
              "built": { "type": "integer", "minimum": 0 },
              "keys": { "type": "integer", "minimum": 0 },
              "without_shaders": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "gpu": { "type": "object" },
    "gaps": { "type": "object" },
    "threads": { "type": "object" },
    "audio": { "type": "object" },
    "logged_slow_frames": { "type": "object" },
    "red_diagnostics": {
      "type": "object",
      "required": ["total_lines", "unique", "cross_referenced_unique", "categories"],
      "properties": {
        "total_lines": { "type": "integer", "minimum": 0 },
        "unique": { "type": "integer", "minimum": 0 },
        "cross_referenced_unique": { "type": "integer", "minimum": 0 },
        "allowed_unique": { "type": "integer", "minimum": 0 },
        "unallowed_unique": { "type": "integer", "minimum": 0 },
        "categories": { "type": "object" }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "milestone", "status", "previous_frame", "mean_abs_rgb_difference", "changed_pixel_fraction"],
        "properties": {
          "path": { "type": "string" },
          "milestone": { "type": ["string", "null"] },
          "status": { "enum": ["ok", "unknown"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "sampled_pixels": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "pixel_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mean_rgb": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
            "items": false
          },
          "mean_luma": { "type": "number" },
          "black_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
          "near_white_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
          "dominant_purple_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
          "coarse_unique_colours": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "coarse_unique_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
          "dominant_coarse_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
          "previous_frame": { "type": ["string", "null"] },
          "mean_abs_rgb_difference": { "type": ["number", "null"], "minimum": 0, "maximum": 255 },
          "changed_pixel_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "error": { "type": "string" }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "pass", "checks"],
      "properties": {
        "status": { "enum": ["pass", "fail", "unknown"] },
        "pass": { "type": "boolean" },
        "reason": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "required", "expected", "actual"],
            "properties": {
              "name": { "type": "string" },
              "status": { "enum": ["pass", "fail", "unknown"] },
              "required": { "const": true },
              "evidence": { "type": "string" },
              "observed_seconds": { "type": ["number", "null"], "minimum": 0, "description": "Telemetry span clipped to the configured gameplay window, independently of screenshot labels; not verification of gameplay content." },
              "source": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "artifacts": { "type": "object" }
  },
  "additionalProperties": true
}
