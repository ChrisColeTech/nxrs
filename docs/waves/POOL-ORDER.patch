+        .retired
+        .iter()
+        .enumerate()
+        .filter(|(_, r)| r.pool.since < view && view <= r.until && r.pool.base <= a)
+        .max_by_key(|(i, r)| (r.pool.base, *i));
+    let pick = match (live, old) {
+        (Some(b), Some((i, r))) if r.pool.base >= b => Some(At::Retired(i)),
+        (Some(b), _) => Some(At::Live(b)),
+        (None, Some((i, _))) => Some(At::Retired(i)),
+        (None, None) => None,
+    };
+    if let Some(at) = pick.filter(|&at| holds(pool_at(m, at))) {
+        return Some(at);
+    }
+    find(m, a, n)
+        .map(At::Live)
+        .or_else(|| m.retired.iter().rposition(|r| holds(&r.pool)).map(At::Retired))
