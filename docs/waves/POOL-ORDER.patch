+/// The last replay op whose work has all run: every op up to it replayed, none of its work held by a parked queue
+/// (`mem::reap`). Not on the replay thread: a replay holding the queues' lock answers 0 (the replay thread asks again
+/// after each op) rather than holding the game thread for it.
+pub fn replayed_through(g: &Gpu) -> u64 {
+    let done = AQ.get().map(|a| a.done.load(Ordering::Acquire)).unwrap_or(u64::MAX);
+    let st = if on_replay_thread() {
+        g.q.sub.lock().unwrap()
+    } else {
+        match g.q.sub.try_lock() {
+            Ok(st) => st,
+            Err(_) => return 0,
+        }
+    };
+    through_of(done, st.parked.values().map(|p| p.oldest))
+}
+
+/// `replayed_through` of `done` replayed ops and the parked queues' oldest ops.
+pub(crate) fn through_of(done: u64, parked_oldest: impl Iterator<Item = u64>) -> u64 {
+    parked_oldest.fold(done, |t, o| t.min(o.saturating_sub(1)))
+}
