+    fn pool(base: u64, size: u64, identity: u64, since: u64) -> Pool {
+        Pool {
+            identity,
+            since,
+            base,
+            size,
+            flags: 0,
+            placement: Placement::Mirror,
+            buf: None,
+            buf_off: 0,
+            watched: false,
+            snapshot: None,
+            page_gen: Vec::new(),
+            page_lo: base,
+            pending: Vec::new(),
+            da: 0,
+            alloc_base: 0,
+            dirty_frame: 0,
+            win: 0,
+            wins: Vec::new(),
+            wins_da: Vec::new(),
+            gran: None,
+            deferred: Vec::new(),
+        }
+    }
+
+    fn id(m: &Pools, at: Option<At>) -> Option<u64> {
+        at.map(|at| pool_at(m, at).identity)
+    }
+
+    /// Audit (1): a pool registered again at the same base while work queued before still names the old one. The
+    /// old one is kept for that work (ops up to 5), the new one serves the work after; the game's lookups see the new
+    /// one. Before: `pool_add` released the old pool at once (`order` false here), so op 5 resolved to the new buffer.
+    #[test]
+    fn same_base_reuse_keeps_the_old_pool_for_the_work_queued_before() {
+        let mut m = Pools::default();
+        m.by_base.insert(0x10000, pool(0x10000, 0x1000, 1, 0));
+        let old = m.by_base.insert(0x10000, pool(0x10000, 0x1000, 2, 5)).unwrap();
+        assert!(retire(&mut m, old, 5, true).is_none(), "kept, not released");
+        assert_eq!(id(&m, find_at(&m, 0x10100, 4, 5)), Some(1), "op 5 was queued before: the old pool");
+        assert_eq!(id(&m, find_at(&m, 0x10100, 4, 6)), Some(2), "op 6 after: the new one");
+        assert_eq!(id(&m, find_at(&m, 0x10100, 4, u64::MAX)), Some(2), "the game's thread: the new one");
+        assert_eq!(find(&m, 0x10100, 4), Some(0x10000));
+        // the earlier behaviour: released at registration, op 5 gets the new pool
+        let mut before = Pools::default();
+        before.by_base.insert(0x10000, pool(0x10000, 0x1000, 1, 0));
+        let old = before.by_base.insert(0x10000, pool(0x10000, 0x1000, 2, 5)).unwrap();
+        assert!(retire(&mut before, old, 5, false).is_some(), "released now");
+        assert_eq!(id(&before, find_at(&before, 0x10100, 4, 5)), Some(2));
+    }
+
+    /// Audit (2): work of ops before a finalize held by a parked queue keeps the pool, though every op up to the
+    /// finalize has been through the replay thread. Before: the deferred removal ran once `done` passed it (a
+    /// parked queue's stream was only appended), so `through` was `done` (10) and the pool went.
+    #[test]
+    fn a_parked_queues_work_keeps_a_retired_pool() {
+        let mut m = Pools::default();
+        let p = pool(0x10000, 0x1000, 1, 0);
+        assert!(retire(&mut m, p, 5, true).is_none());
+        let through = super::super::queue::through_of(10, [4u64].into_iter());
+        assert_eq!(through, 3, "a queue parked with op 4's work");
+        assert!(take_reaped(&mut m, through).is_empty(), "op 4's work has not run");
+        assert_eq!(id(&m, find_at(&m, 0x10100, 4, 4)), Some(1), "and replays with op 4's view");
+        let through = super::super::queue::through_of(10, [6u64].into_iter());
+        assert_eq!(take_reaped(&mut m, through).len(), 1, "parked work is newer: released");
+        assert!(m.retired.is_empty());
+        assert_eq!(super::super::queue::through_of(10, std::iter::empty()), 10);
+    }
+
+    /// Audit (3): a finalized pool kept for queued work does not hide a new pool below it from the game's lookups
+    /// (`addr_known`, `room`) nor share the write watch with it: it is out of the live map, the one `begin_submit`
+    /// watches. Before: it stayed in the live map, and `find` gave it for the new pool's addresses above its base.
+    #[test]
+    fn a_retired_pool_does_not_shadow_a_new_lower_pool() {
+        let mut m = Pools::default();
+        m.by_base.insert(0x20000, pool(0x20000, 0x10000, 1, 0));
+        let r = m.by_base.remove(&0x20000).unwrap();
+        assert!(retire(&mut m, r, 5, true).is_none());
+        m.by_base.insert(0x18000, pool(0x18000, 0x20000, 2, 5));
+        assert_eq!(find(&m, 0x22000, 4), Some(0x18000), "the game's lookups: the new pool");
+        assert_eq!(id(&m, find_at(&m, 0x22000, 4, u64::MAX)), Some(2));
+        assert!(!m.by_base.contains_key(&0x20000), "the watch scans the live map only");
+        assert_eq!(id(&m, find_at(&m, 0x22000, 4, 5)), Some(1), "work queued before: the finalized pool");
+        assert_eq!(id(&m, find_at(&m, 0x22000, 4, 6)), Some(2), "work queued after: the new one");
+        // a parked queue's later records (replayed with an older op's view) still reach a pool registered after it
+        assert_eq!(id(&m, find_at(&m, 0x19000, 4, 3)), Some(2));
+        // the earlier behaviour: both in the live map, the old one shadows the new one's addresses above its base
+        let mut before = Pools::default();
+        before.by_base.insert(0x20000, pool(0x20000, 0x10000, 1, 0));
+        before.by_base.insert(0x18000, pool(0x18000, 0x20000, 2, 5));
+        assert_eq!(find(&before, 0x22000, 4), Some(0x20000));
+    }
+}
