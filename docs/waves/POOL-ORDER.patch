+/// The pool owning [a, a + n) for the replay of op `view`: the pools as they were when it was queued (live ones
+/// registered before it, retired ones that went after it), highest base at or below `a` as in `find`. Not there
+/// (a parked queue's later records replay with its oldest op's view; work naming memory already gone): the live map,
+/// then the retired pools, newest first. `view` u64::MAX (the game's threads): the live map only.
+fn find_at(m: &Pools, a: u64, n: u64, view: u64) -> Option<At> {
+    if view == u64::MAX || m.retired.is_empty() {
+        return find(m, a, n).map(At::Live);
+    }
+    let holds = |p: &Pool| p.base <= a && a + n <= p.base + p.size;
+    let live = m.by_base.range(..=a).rev().find(|(_, p)| p.since < view).map(|(b, _)| *b);
